# Public base URL. Used for canonical tags, Open Graph URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://savegram.app

# Signs the short lived download tokens. Required in production.
# Generate one with: openssl rand -base64 32
SAVEGRAM_TOKEN_SECRET=

# --- Extraction backend -----------------------------------------------------
# "ytdlp" runs the yt-dlp binary on this server. "http" calls an external
# service. Leave unset to use http when an endpoint is set, and ytdlp otherwise.
SAVEGRAM_RESOLVER=ytdlp

# yt-dlp backend
SAVEGRAM_YTDLP_PATH=yt-dlp

# Instagram requires a signed in session, so it needs a Netscape format cookie
# file. TikTok and Facebook do not. Point this at a file readable by the server.
# SAVEGRAM_YTDLP_COOKIES_INSTAGRAM=/etc/savegram/instagram-cookies.txt
# Applies to every platform that has no specific file set:
# SAVEGRAM_YTDLP_COOKIES=

# http backend. Resolve requests are POSTed here as { platform, url }.
# SAVEGRAM_RESOLVER_ENDPOINT=
# SAVEGRAM_RESOLVER_TOKEN=
# Per platform overrides win over the shared values above.
# SAVEGRAM_RESOLVER_ENDPOINT_TIKTOK=

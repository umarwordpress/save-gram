# Public base URL. Used for canonical tags, Open Graph URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://savegram.app

# Signs download links. Required in production.
# On the Vercel setup this must match SAVEGRAM_TOKEN_SECRET on the extractor.
# Generate one with: openssl rand -base64 32
SAVEGRAM_TOKEN_SECRET=

# --- Extraction backend -----------------------------------------------------
# "remote" calls the service in services/extractor. Use this on Vercel, which
#          cannot run a binary.
# "ytdlp"  runs yt-dlp on this machine. Needs a host that allows subprocesses.
# "http"   calls any service that speaks the ResolverResult contract.
# Leave unset to pick automatically from what is configured below.
SAVEGRAM_RESOLVER=remote

# remote backend
SAVEGRAM_EXTRACTOR_URL=https://your-extractor.up.railway.app
SAVEGRAM_EXTRACTOR_TOKEN=

# ytdlp backend
# SAVEGRAM_YTDLP_PATH=yt-dlp
# Instagram needs a signed in session; TikTok and Facebook do not.
# SAVEGRAM_YTDLP_COOKIES_INSTAGRAM=/etc/savegram/instagram-cookies.txt

# http backend
# SAVEGRAM_RESOLVER_ENDPOINT=
# SAVEGRAM_RESOLVER_TOKEN=

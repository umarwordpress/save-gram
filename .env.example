# Public base URL. Used for canonical tags, Open Graph URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://savegram.app

# Signs the short lived download tokens. Required in production.
# Generate one with: openssl rand -base64 32
SAVEGRAM_TOKEN_SECRET=

# Extraction backend. Resolve requests are POSTed here as { platform, url }.
# Set one endpoint for every platform:
SAVEGRAM_RESOLVER_ENDPOINT=
SAVEGRAM_RESOLVER_TOKEN=

# Or override per platform. These win over the shared value above.
# SAVEGRAM_RESOLVER_ENDPOINT_INSTAGRAM=
# SAVEGRAM_RESOLVER_ENDPOINT_TIKTOK=
# SAVEGRAM_RESOLVER_ENDPOINT_FACEBOOK=
# SAVEGRAM_RESOLVER_TOKEN_INSTAGRAM=

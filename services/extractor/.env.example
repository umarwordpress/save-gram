# Port the service listens on. Most hosts set this for you.
PORT=8080

# Shared with the SaveGram app as SAVEGRAM_EXTRACTOR_TOKEN.
# Protects /extract and /stream. Generate: openssl rand -base64 32
SAVEGRAM_EXTRACTOR_TOKEN=

# Shared with the SaveGram app as SAVEGRAM_TOKEN_SECRET. Must be identical on
# both sides, since the app signs the browser download links and this service
# verifies them.
SAVEGRAM_TOKEN_SECRET=

# Instagram requires a signed in session. Point this at a Netscape format
# cookie file. TikTok and Facebook do not need one.
# YTDLP_COOKIES_INSTAGRAM=/etc/savegram/instagram-cookies.txt

# YTDLP_PATH=yt-dlp
# EXTRACT_TIMEOUT_MS=45000
